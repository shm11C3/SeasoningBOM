{
  "name": "seasoning-bom",
  "version": "0.1.0",
  "description": "A GitHub-parody recipe sharing service that treats recipes like repositories and ingredients like dependencies.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite",
    "dev:worker": "pnpm exec wrangler dev",
    "db:migrate:local": "pnpm exec wrangler d1 migrations apply seasoning-bom --local",
    "db:seed:local": "pnpm exec wrangler d1 execute seasoning-bom --local --file examples/seed-public-repositories.sql",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "biome check . && pnpm run check:boundaries && tsc -b",
    "check:boundaries": "node --test scripts/check-runtime-boundaries.node-test.mjs && node scripts/check-runtime-boundaries.mjs",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clerk/backend": "^3.10.0",
    "@clerk/react": "^6.12.6",
    "@primer/react": "^38.30.0",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^4.4.0",
    "hono": "^4.12.27",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.11",
    "wrangler": "4.113.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  }
}
